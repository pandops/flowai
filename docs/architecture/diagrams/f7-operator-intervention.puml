@startuml f7-operator-intervention
title F7 - Operator intervenes mid-loop (GW -> State Registry -> EX)

|Operator|
start
:Open task in UI (already connected via F3);
:Choose intervention:
 inject message / cancel / rerun;

|UI|
:Send WS message
 with bearer_token,
   type: control,
   action: <X>,
   payload;

|API Gateway|
:Validate bearer_token;
note right
  GW's only logic.
  Auth + route.
  No connection to Router.
end note
:REST POST /control-requests to State Registry
 with bearer_token, task_id, action, payload;

|State Registry|
:Append control-request record;
:Append operator audit entry;

|EX|
:Poll/read pending control requests
 for assigned task_id;
:Receive control request;

if (Action?) then (cancel)
  :Send SIGTERM to AG;
  -->[graceful] "See F8 (finalize)"
elseif (inject message) then
  :Write message to AG stdin;
elseif (rerun) then
  :Restart AG with same scope_token;
  -->[restart] "See F4 again"
else (unknown)
  :Log warning;
  :Drop frame;
  stop
endif

|AG|
:Receive signal / message;

if (Action?) then (cancel)
  :Clean shutdown;
  -->[done] "Exit loop, emit final event";
  stop
elseif (inject)
  :Treat message as next user turn;
  -->[continue] "Resume agent loop (see F6)";
  stop
elseif (rerun)
  -->[restart] "See F4 (executor pool + dispatch)";
  stop
endif

@enduml
