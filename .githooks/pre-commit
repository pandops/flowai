#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -d openspec ]; then
  exit 0
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "OpenSpec validation requires npx. Install Node.js/npm or run openspec validate manually." >&2
  exit 1
fi

mkdir -p .tools/openspec/npm-cache

OPEN_SPEC_INTERACTIVE=0 \
  OPENSPEC_TELEMETRY=0 \
  npx --yes --cache .tools/openspec/npm-cache @fission-ai/openspec@1.5.0 validate --all --strict --no-interactive
