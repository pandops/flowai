' diagram-type: sequence
@startuml
!pragma layout smetana
title v0008 State Registry - Transit Secret Write and Open (Happy Path)

actor "Operator" as operator_user
participant "Web UI" as web_ui_service
participant "Trusted API Gateway" as trusted_gateway
database "State Registry" as state_registry_service
participant "OpenBao Transit" as openbao_transit_server
database "PostgreSQL\n(secret_versions.crypto_provider)" as state_registry_db
actor "Assigned Executor" as assigned_executor_user

== Operator stores a secret under a team-wide environment ==
operator_user -> web_ui_service : create secret (plaintext value)
activate web_ui_service
web_ui_service -> trusted_gateway : POST /v1/environments/{id}/secrets\n(team-filtered operator context)
activate trusted_gateway
trusted_gateway -> state_registry_service : POST /v1/environments/{id}/secrets\n(trusted gateway context)
activate state_registry_service
state_registry_service -> state_registry_service : canonical team check\ncanonical applicability check
state_registry_service -> openbao_transit_server : POST /v1/<mount>/encrypt/<key_name>\nplaintext=<b64>, associated_data=<b64>\n(binds team_id, logical_secret_id, version)
activate openbao_transit_server
openbao_transit_server -> openbao_transit_server : aes256-gcm96, fresh nonce,\n128-bit auth tag, embedded key version
openbao_transit_server --> state_registry_service : 200 ciphertext=vault:v<N>:...\n(opaque key_id, opaque key_version=N)
deactivate openbao_transit_server
state_registry_service -> state_registry_db : INSERT secret_versions\n(ciphertext, opaque key_id, key_version=N,\ncrypto_provider='transit')
activate state_registry_db
state_registry_db --> state_registry_service : persisted
deactivate state_registry_db
state_registry_service -> state_registry_service : audit secret.create accepted\n(identifier-level metadata only)
state_registry_service --> trusted_gateway : 201 SecretWriteResponse\n(key_id, key_version, environment_id)
deactivate state_registry_service
trusted_gateway --> web_ui_service : 201 SecretWriteResponse
deactivate trusted_gateway
web_ui_service --> operator_user : secret_id, version, key_id, key_version
deactivate web_ui_service

note over operator_user, assigned_executor_user
  Public opaque envelope: key_id (string, ^[A-Za-z0-9][A-Za-z0-9._:-]*$),
  key_version (integer >= 1). The Transit ciphertext form
  vault:v<N>:... is internal-only and never exposed.
end note

== Assigned Executor opens the same environment under a valid scope token ==
assigned_executor_user -> state_registry_service : GET /v1/environments/{id}/open?task_id=<task_id>\nX-FlowAI-Scope-Token: <header>.<payload>.<signature>
activate state_registry_service
state_registry_service -> state_registry_service : mTLS / Executor service identity verified\nkid == payload.key_id? aud == literal?\nissued_at / expiry / canonical claims same-team?\nassigned Executor? task non-terminal?

alt invalid or unavailable (any failure class)
  state_registry_service --> assigned_executor_user : 404 environment_unknown_or_unavailable\n(no decrypt call, no provider detail)
  deactivate state_registry_service
else valid token
  state_registry_service -> openbao_transit_server : POST /v1/<mount>/decrypt/<key_name>\nciphertext=<exact>, associated_data=<canonical>
  activate openbao_transit_server
  alt provider failure (sealed / unavailable / ACL / mount / key / version / tampered / wrong AAD)
    openbao_transit_server --> state_registry_service : documented failure class
    deactivate openbao_transit_server
    state_registry_service --> assigned_executor_user : 404 environment_unknown_or_unavailable\n(audit only identifier-level metadata)
    deactivate state_registry_service
  else success
    openbao_transit_server --> state_registry_service : 200 plaintext=<b64>
    deactivate openbao_transit_server
    state_registry_service -> state_registry_service : decode plaintext in memory only
    state_registry_service -> state_registry_service : audit secret.open accepted\n(identifier-level metadata only)
    state_registry_service --> assigned_executor_user : 200 OpenEnvironmentResponse\n(team_id, project_id, task_id,\n environment_id, executor_id, values)
    deactivate state_registry_service
  end
end
@enduml