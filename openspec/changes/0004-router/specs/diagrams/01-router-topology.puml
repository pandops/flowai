@startuml
title 0004-router - broker topology

participant "Automation" as Auto
participant "Router" as Router
database "Router DB" as Db
participant "Docker Executor" as DockerEx
participant "State Registry" as State
participant "Env Registry" as Env

Auto -> Router : POST /tasks
Router -> Db : queue, wait list, executor pool, assignments
DockerEx -> Router : register, ready, pull, status, running_child_count
Router -x State : forbidden
Router -x Env : forbidden

@enduml
