' diagram-type: sequence
@startuml
title v0006-web-ui - no-auth API Gateway routing and admin boundary

participant "Web UI / Browser" as web_browser
participant "API Gateway" as api_gateway
participant "State Registry" as state_registry
participant "Executor" as executor_service

web_browser -> api_gateway : platform HTTP request\n(possibly forged X-FlowAI-* headers)
activate api_gateway
api_gateway -> api_gateway : remove browser Operator-ID, Team-ID,\nTeam-Name, Request-ID, and credentials

alt target is /admin/*
  api_gateway --> web_browser : reject before State Registry call
else target is Executor or another backend
  api_gateway --> web_browser : reject forbidden target
else required operator_id/team_id invalid\nor supplied team_name empty/invalid
  api_gateway --> web_browser : reject before child request
else allowlisted operator route and team_name absent
  api_gateway -> api_gateway : generate request_id
  api_gateway -> state_registry : child request with configured Operator-ID,\nconfigured Team-ID, Request-ID\n(no Team-Name, no browser credential)
  activate state_registry
  state_registry -> state_registry : enforce ownership by team_id\nattribute audit by operator_id + request_id
  state_registry --> api_gateway : backend response
  deactivate state_registry
  api_gateway --> web_browser : status, headers, body unchanged
else allowlisted operator route and team_name present
  api_gateway -> api_gateway : generate request_id
  api_gateway -> state_registry : child request with configured Operator-ID,\nconfigured Team-ID, optional Team-Name, Request-ID\n(no browser credential)
  activate state_registry
  state_registry -> state_registry : enforce ownership by team_id\nuse team_name for display/audit only
  state_registry --> api_gateway : backend response
  deactivate state_registry
  api_gateway --> web_browser : status, headers, body unchanged
end

deactivate api_gateway
note over api_gateway, executor_service
  API Gateway never calls an Executor.
  System administrators call State Registry /admin/* directly
  under authenticated system-administrator identity.
end note

@enduml
