' diagram-type: sequence
@startuml
title v0006-web-ui - configured single-team operator surface without auth

actor "Operator" as operator_actor
participant "Web UI\nno team or admin controls" as web_ui
participant "API Gateway\nno-auth bootstrap context" as api_gateway
participant "State Registry\nresource authority" as state_registry

note over api_gateway
  Required configuration:
  - one non-empty bootstrap operator_id
  - one non-empty immutable team_id
  Optional configuration:
  - canonical display-only team_name
  operator_id is audit attribution, not authentication proof.
  team_id is the only tenant authority.
end note

operator_actor -> web_ui : open dashboard without credentials
activate web_ui
web_ui -> web_ui : render task, event, control,\nenvironment, and secret surfaces\nshow team_name only when present
web_ui --> operator_actor : configured-team operator surface\n(no team/admin/source-system/task-type controls)
deactivate web_ui

operator_actor -> web_ui : read or mutate operator-owned state
activate web_ui
web_ui -> api_gateway : REST or WebSocket request\n(no X-FlowAI-* identity headers)
activate api_gateway
api_gateway -> api_gateway : strip forged internal context\nvalidate required operator_id and team_id\nvalidate team_name only when supplied\ngenerate request_id

alt required bootstrap context invalid\nor supplied team_name empty/invalid
  api_gateway --> web_ui : reject before child request
else valid context without team_name
  api_gateway -> state_registry : child request with Operator-ID, Team-ID, Request-ID\n(no Team-Name)
  activate state_registry
  state_registry -> state_registry : authorize only by team_id\nattribute by operator_id + request_id
  state_registry --> api_gateway : canonical response
  deactivate state_registry
  api_gateway --> web_ui : status, headers, body unchanged
else valid context with team_name
  api_gateway -> state_registry : child request with Operator-ID, Team-ID,\noptional Team-Name, Request-ID
  activate state_registry
  state_registry -> state_registry : authorize only by team_id\nretain team_name as display/audit context
  state_registry --> api_gateway : canonical response
  deactivate state_registry
  api_gateway --> web_ui : status, headers, body unchanged
end
deactivate api_gateway
web_ui --> operator_actor : render response
deactivate web_ui

note over web_ui, api_gateway
  Web UI calls only API Gateway.
  API Gateway calls only allowlisted operator routes on State Registry.
  Every /admin/* route is unavailable through this path.
end note

@enduml
