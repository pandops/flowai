' diagram-type: sequence
@startuml
title v0006-web-ui - configured-team live events without auth

participant "Web UI / Browser" as web_browser
participant "API Gateway" as api_gateway
participant "State Registry" as state_registry

web_browser -> api_gateway : WebSocket upgrade\n(possibly forged X-FlowAI-* headers)
activate api_gateway
api_gateway -> api_gateway : strip browser identity context\nvalidate required operator_id and team_id\nvalidate optional team_name when supplied\ngenerate request_id

alt required context invalid\nor supplied team_name empty/invalid
  api_gateway --> web_browser : reject upgrade before subscription
else valid context
  api_gateway -> state_registry : subscribe with configured Operator-ID, Team-ID,\noptional Team-Name only when present, Request-ID\n(no browser bearer credential)
  activate state_registry
  state_registry -> state_registry : bind connection permanently to team_id\napply team filter before replay, cursor,\nlive fan-out, and frame serialization
  loop authorized configured-team events
    state_registry --> api_gateway : unchanged team-owned event frame
    api_gateway --> web_browser : unchanged event frame
  end
  web_browser -> api_gateway : close WebSocket
  api_gateway -> state_registry : close child subscription
  state_registry --> api_gateway : subscription closed
  deactivate state_registry
  api_gateway --> web_browser : WebSocket closed
end
deactivate api_gateway

note over web_browser, state_registry
  No foreign-team frame, count, cursor, or existence signal is exposed.
  /admin/* is not a WebSocket operator surface.
end note

@enduml
