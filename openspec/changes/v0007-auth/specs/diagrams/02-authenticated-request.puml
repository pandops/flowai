' diagram-type: sequence
@startuml
title v0007-auth - authenticated team-scoped REST request

participant "Web UI / Browser" as web_ui
participant "API Gateway" as api_gateway
participant "Keycloak" as keycloak
participant "State Registry\nteam mapping, resource, and audit authority" as state_registry

web_ui -> api_gateway : REST + one-team working bearer\n(possibly forged groups or X-FlowAI-* headers)
activate api_gateway
api_gateway -> api_gateway : validate signature/issuer, audience, expiry,\noperator_id, exactly one team_id
api_gateway -> keycloak : obtain current canonical groups
activate keycloak
keycloak --> api_gateway : canonical group IDs / invalid identity
deactivate keycloak
api_gateway -> state_registry : resolve canonical groups
activate state_registry
state_registry --> api_gateway : current accessible teams
deactivate state_registry
alt missing, invalid, expired, unresolved, or stale context
  api_gateway --> web_ui : reject before proxying
else valid canonical context
  api_gateway -> api_gateway : strip browser groups, identity headers, Authorization\ngenerate request_id
  api_gateway -> state_registry : child request with canonical Operator-ID, Team-ID,\ndisplay-only Team-Name, Request-ID\n(no browser or Keycloak credential)
  activate state_registry
  state_registry -> state_registry : authorize resource by stable team_id
  opt operator mutation
    state_registry -> state_registry : persist canonical audit using\noperator_id + team_id + request_id
  end
  state_registry --> api_gateway : backend response
  deactivate state_registry
  api_gateway --> web_ui : status, headers, and body unchanged
end
deactivate api_gateway

@enduml
