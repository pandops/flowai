# OpenSpec contract artifacts are tracked.
!openspec/
!openspec/config.yaml
!openspec/project.md
!openspec/AGENTS.md
!openspec/specs/
!openspec/specs/**
!openspec/changes/
!openspec/changes/**

# OpenCode surface (skills, commands, package) is environment-local.
# The canonical openspec skill is symlinked from ~/config/ai/skills/openspec/
# via .opencode/skills/openspec and resolves to the single source of truth.
.opencode/

# Local agent skill symlinks; canonical skills live outside this repo.
.agents/skills

# Local OpenSpec CLI/runtime cache. Persist only openspec/ source artifacts.
.tools/openspec
openspec/.cache/
openspec/tmp/
openspec/temp/

# Local environment and secret files. Commit examples/templates instead.
.env
.env.*
!.env.example
!.env.*.example

# Package-manager/runtime artifacts that may appear while using npx/npm.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/

# Local editor and automation state.
.idea
.vscode
.omo/run-continuation
